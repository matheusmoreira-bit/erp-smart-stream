# ============================================================================
# Exemplo de configuração — copie para docker/.env e ajuste
# ============================================================================
# NUNCA commite docker/.env. Este .env.example serve apenas de template.
# ============================================================================

# ---- Segredos do stack local -----------------------------------------------
# Postgres superuser (uso interno dos serviços)
POSTGRES_PASSWORD=change-me-qa-local

# JWT compartilhado por Auth, PostgREST, Storage, Realtime e Edge Runtime.
# Gere: openssl rand -base64 48
JWT_SECRET=super-long-jwt-secret-change-me-please-32chars-min

# Realtime SECRET_KEY_BASE (mín. 64 chars). Gere: openssl rand -base64 64
SECRET_KEY_BASE=change-me-realtime-secret-key-base-min-64-chars-abcdef1234567890

# ---- JWTs pré-assinados para roles anon e service_role ---------------------
# Gere com o script:  make qa-jwt
# Ou manualmente em https://jwt.io usando JWT_SECRET acima, payload:
#   { "role": "anon",         "iss": "supabase", "iat": <now>, "exp": <now+10y> }
#   { "role": "service_role", "iss": "supabase", "iat": <now>, "exp": <now+10y> }
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.PLACEHOLDER_ANON.PLACEHOLDER
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.PLACEHOLDER_SERVICE.PLACEHOLDER

# ---- Kill-switch de integrações externas -----------------------------------
# disabled = funções que fazem HTTP externo (SAP/OMIE/PagCorp/JumpCloud/Google)
#            devem verificar Deno.env.get("INTEGRATIONS_MODE") e recusar.
# enabled  = usa os segredos reais (NÃO recomendado em QA local com dump de prod).
INTEGRATIONS_MODE=disabled

# Login fake só é aceito com project_id e backend locais.
VITE_ENABLE_FAKE_AUTH=false

# ---- Seed a partir de S3 ---------------------------------------------------
# Prefixo do dump gerado pela edge function db-backup-s3 (Fase 2).
# Ex.: daily/2026-07-22 -> baixa manifest.json + <tabela>.jsonl.gz do bucket.
SEED_S3_BUCKET=
SEED_S3_PREFIX=daily/latest
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
