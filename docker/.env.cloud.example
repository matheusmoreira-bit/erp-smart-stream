# Copy to docker/.env.cloud, fill the values, then run: make cloud-preflight
# Keep the real file chmod 600 and outside version control.

# gcp or aws. The application stack itself is provider-neutral.
CLOUD_PROVIDER=gcp

# Public endpoint. Frontend and Supabase APIs share the same origin.
APP_DOMAIN=erp.example.com
APP_PUBLIC_URL=https://erp.example.com
SUPABASE_PUBLIC_URL=https://erp.example.com
TLS_EMAIL=infra@example.com
VITE_SUPABASE_PROJECT_ID=erp-flow-cloud
VITE_ENABLE_FAKE_AUTH=false

# Generate every value independently. Never reuse production Lovable secrets.
# openssl rand -base64 36
POSTGRES_PASSWORD=change-me
# openssl rand -base64 48
JWT_SECRET=change-me
# openssl rand -base64 64
SECRET_KEY_BASE=change-me
# openssl rand -base64 48 (guarde a mesma chave para restores)
CREDENTIALS_ENCRYPTION_KEY=change-me

# Generate after JWT_SECRET: make cloud-jwt
ANON_KEY=change-me
SERVICE_ROLE_KEY=change-me

# Authentication. Keep signup disabled and provision users explicitly.
AUTH_DISABLE_SIGNUP=true
AUTH_REDIRECT_ALLOW_LIST=https://erp.example.com
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# External integrations. Start disabled and enable only after the smoke test.
INTEGRATIONS_MODE=disabled
SAP_CONNECTIVITY_MODE=public
SAP_DEFAULT_BASE_URL=https://sap.example.com/b1s/v2
# openssl rand -base64 48
SAP_MIDDLEWARE_SECRET=
# openssl rand -base64 32
SAP_CRED_ENC_KEY=
SAP_FALLBACK_ADMIN_USERNAME=
SAP_FALLBACK_ADMIN_PASSWORD=
PAGCORP_API_KEY=
OMIE_APP_KEY=
OMIE_APP_SECRET=
JUMPCLOUD_API_KEY=
LOVABLE_API_KEY=
EXTERNAL_APPROVALS_API_KEY=
SMTP_PASSWORD=
CRON_SECRET=
WHATSAPP_URL=
WHATSAPP_TOKEN=

# Edge Functions currently enforce authorization individually.
FUNCTIONS_VERIFY_JWT=false

# Local validation only. Keep false when using a public CA certificate.
CLOUD_SMOKE_INSECURE=false

# Optional legacy S3 backup functions.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=sa-east-1
AWS_S3_BACKUP_BUCKET=

# Host backup script: local, s3 or gcs.
BACKUP_TARGET=local
BACKUP_BUCKET_URI=
BACKUP_RETENTION_DAYS=7
