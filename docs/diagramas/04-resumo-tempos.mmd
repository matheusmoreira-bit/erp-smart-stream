        Val[buildValidations<br/>regras de SLA]
        Ins[generateInsights<br/>gargalos / atrasos]
    end

    subgraph UI["Dashboard"]
        FT[FlowTimeline]
        MC[MetricCards]
        IP[InsightsPanel]
        VT[ValidationTable]
    end

